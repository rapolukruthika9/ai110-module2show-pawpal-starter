classDiagram
    class Owner {
        +str name
        +str email
        +list~Pet~ pets
        +add_pet(pet) None
        +get_pet_by_name(name) Pet
        +get_all_tasks() list~Task~
    }

    class Pet {
        +str name
        +str species
        +str breed
        +int age
        +list~Task~ tasks
        +add_task(task) None
        +task_count() int
    }

    class Priority {
        <<enumeration>>
        LOW
        MEDIUM
        HIGH
    }

    class Task {
        +str title
        +int duration_minutes
        +Priority priority
        +str pet_name
        +int preferred_time
        +bool is_recurring
        +str frequency
        +int day_of_week
        +bool is_complete
        +end_time() int
        +conflicts_with(other) bool
        +is_high_priority() bool
        +mark_complete() None
    }

    class Scheduler {
        +Owner owner
        +add_task(task) None
        +sort_tasks() list~Task~
        +detect_conflicts() list~tuple~
        +build_daily_schedule(available_minutes) list~Task~
        +expand_recurring(day_of_week) list~Task~
    }

    Owner "1" --> "many" Pet : has
    Owner "1" --> "1" Scheduler : uses
    Pet "1" --> "many" Task : has
    Scheduler ..> Owner : reads tasks via get_all_tasks()
    Task "many" --> "1" Pet : assigned to (by pet_name, validated on add_task)
    Task ..> Priority : uses
